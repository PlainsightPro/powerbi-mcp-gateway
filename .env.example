# Entra app registration (confidential client used by the OAuth proxy and for the on-behalf-of exchange)
PBIMCP_TENANT_ID=00000000-0000-0000-0000-000000000000
PBIMCP_CLIENT_ID=
PBIMCP_CLIENT_SECRET=
# Public URL of this server (redirect URI = <base_url>/auth/callback must be registered on the app)
PBIMCP_BASE_URL=http://localhost:8000
# Fixed key so server-issued tokens survive restarts (any long random string)
PBIMCP_JWT_SIGNING_KEY=
# Name shown to MCP clients
PBIMCP_SERVER_NAME=Power BI MCP Gateway
# Your own skills folder (instructions, glossary, rules, recipes, catalog); defaults to ./skills (example)
# Leave unset to use the public examples; do not set an empty path.
# PBIMCP_SKILLS_DIR=C:/private/powerbi-skills/internal
# Foundry (Azure OpenAI) endpoint and deployment used by generate_dax; auth = Entra (managed identity / az login)
PBIMCP_FOUNDRY_ENDPOINT=https://<your-foundry>.openai.azure.com
PBIMCP_FOUNDRY_DEPLOYMENT=gpt-5
PBIMCP_FOUNDRY_REASONING_EFFORT=low
# Optional: API key instead of Entra for the Foundry endpoint
# PBIMCP_FOUNDRY_API_KEY=
