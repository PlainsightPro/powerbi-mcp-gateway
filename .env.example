# Copy to .env for local runs. Every PBIMCP_* setting is listed; only the first block is required.

# --- Entra app registration (confidential client used by the OAuth proxy and for the on-behalf-of exchange)
PBIMCP_TENANT_ID=00000000-0000-0000-0000-000000000000
PBIMCP_CLIENT_ID=
PBIMCP_CLIENT_SECRET=
# Public URL of this server (redirect URI = <base_url>/auth/callback must be registered on the app)
PBIMCP_BASE_URL=http://localhost:8000
# Fixed key so server-issued tokens survive restarts (any long random string)
PBIMCP_JWT_SIGNING_KEY=
# Name shown to MCP clients
PBIMCP_SERVER_NAME=Power BI MCP Gateway
# Scope exposed by the Entra app; the deploy script creates access_as_user
# PBIMCP_API_SCOPE_NAME=access_as_user

# --- Skills
# Your own skills folder (instructions, glossary, rules, recipes, catalog); defaults to ./skills (example)
# Leave unset to use the public examples; do not set an empty path.
# PBIMCP_SKILLS_DIR=C:/private/powerbi-skills/internal

# --- Foundry (Azure OpenAI) used by generate_dax; auth = Entra (managed identity / az login)
PBIMCP_FOUNDRY_ENDPOINT=https://<your-foundry>.openai.azure.com
PBIMCP_FOUNDRY_DEPLOYMENT=gpt-5
# minimal | low | medium | high
PBIMCP_FOUNDRY_REASONING_EFFORT=low
# Output budget per generation; reasoning tokens count too. Raise it if answers get cut off.
# PBIMCP_FOUNDRY_MAX_OUTPUT_TOKENS=4000
# Optional: API key instead of Entra for the Foundry endpoint
# PBIMCP_FOUNDRY_API_KEY=

# --- Power BI / Fabric endpoints (change only for sovereign clouds or tests)
# PBIMCP_FABRIC_API_URL=https://api.fabric.microsoft.com/v1
# PBIMCP_HOSTED_MCP_URL=https://api.fabric.microsoft.com/v1/mcp/powerbi

# --- Behaviour
# Seconds a user's model list is cached (which models they can open)
# PBIMCP_CATALOG_CACHE_SECONDS=300
# Seconds a model's schema is cached per user (also grounds generate_dax); a model change is invisible until it expires
# PBIMCP_SCHEMA_CACHE_SECONDS=600
# Rows per query when the client passes no max_rows, and the ceiling whatever it asks for
# PBIMCP_DEFAULT_MAX_ROWS=250
# PBIMCP_MAX_ROWS_LIMIT=10000
# DEBUG | INFO | WARNING
# PBIMCP_LOG_LEVEL=INFO
# Bind address and port
# PBIMCP_HOST=0.0.0.0
# PBIMCP_PORT=8000
